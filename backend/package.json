{
  "name": "clutchnex-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CLUTCHNEX Free Fire esports tournament platform \u2014 API-first backend (Express + Prisma + PostgreSQL)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "postinstall": "node scripts/offline-prisma-patch.mjs",
    "db:dev": "node scripts/dev-db.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "db:push": "prisma db push",
    "db:migrate": "node scripts/migrate-deploy.mjs",
    "db:migrate:cli": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-prize-pool": "tsx prisma/backfill-prize-pool.ts",
    "db:seed:admin": "tsx prisma/admin-seed.ts",
    "studio": "prisma studio",
    "verify:join": "tsx scripts/verify-join-engine.mts",
    "verify:wallet": "tsx scripts/verify-wallet.mts",
    "verify:results": "tsx scripts/verify-results.mts",
    "verify:finance": "tsx scripts/verify-finance.mts",
    "verify:support": "tsx scripts/verify-support.mts",
    "verify:seo": "tsx scripts/verify-seo.mts",
    "verify:pwa": "tsx scripts/verify-pwa.mts",
    "verify:security": "tsx scripts/verify-security.mts",
    "verify:concurrency": "node scripts/verify-concurrency.mjs",
    "test:auth-race": "node scripts/auth-race-test.mjs",
    "test:auth-expiry": "node scripts/auth-expiry-test.mjs",
    "db:real": "node scripts/real-db.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@electric-sql/pglite-socket": "^0.2.10",
    "@prisma/prisma-schema-wasm": "^7.10.0-4.0edf323efd1d98336f3f0a68684b56f689b900d3",
    "@prisma/schema-engine-wasm": "^7.10.0-4.0edf323efd1d98336f3f0a68684b56f689b900d3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
