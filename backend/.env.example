# === CLUTCHNEX backend environment (example — copy to .env and fill) ===

# --- PostgreSQL — Neon (or any managed Postgres) -----------------------------
# TWO connection strings, TWO jobs (Prisma 7 driver-adapter setup):
#
# DATABASE_URL — RUNTIME API traffic (src/lib/prisma.ts). Use Neon's POOLED
#                endpoint: the host contains "-pooler". PgBouncer multiplexes
#                thousands of API clients over a few real connections, which is
#                what survives 1,000–2,000 concurrent users.
# DIRECT_URL   — PRISMA CLI only (migrate deploy/dev, studio). Use the DIRECT
#                (unpooled) host — the one WITHOUT "-pooler". Migrations must
#                not run through PgBouncer (advisory locks + session state).
#
# In Neon: Dashboard → your project (ep-empty-fire-aeiut8pg) → Connection
# Details → toggle "Pooled connection" ON for DATABASE_URL, OFF for DIRECT_URL.
# Always keep `sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-empty-fire-aeiut8pg-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connection_limit=10"
DIRECT_URL="postgresql://USER:PASSWORD@ep-empty-fire-aeiut8pg.REGION.aws.neon.tech/neondb?sslmode=require"

# Local dev without Neon (no Postgres install needed): leave both unset and
# run `npm run db:dev` (embedded PGlite PostgreSQL on :5432), then
# `npm run db:migrate` + `npm run db:seed`.
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?connection_limit=5"

# Pool sizing: `connection_limit` caps the per-process pool. Keep
# `instances × connection_limit` under your plan's cap (Neon pooler allows
# far more; direct endpoints often cap at ~100).

# --- Server ---
PORT=4000
NODE_ENV=development
# Railway production: https:// URLs (the API refuses to boot otherwise)
CLIENT_ORIGIN="http://localhost:3000"

# --- Auth — use long random secrets in production (openssl rand -hex 64) ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"

# --- Super-admin provisioning (secrets NEVER live in source) ------------------
# `npm run db:seed:admin` (prisma/admin-seed.ts) upserts this account by email
# and re-bakes its bcrypt hash from SEED_ADMIN_PASSWORD, so an .env change can
# never desync the login. In production SEED_ADMIN_PASSWORD is REQUIRED
# (min 12 chars); if it is unset the seed is skipped instead of provisioning a
# predictable password. Generate one with: openssl rand -base64 24
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_USERNAME="clutchnexadmin"
SEED_ADMIN_NAME="Platform Owner"

# Public URL (SEO, shares). PRODUCTION MUST BE https:// (startup guard).
PUBLIC_URL="http://localhost:3000"

# --- Tournament room release (Room ID / password timing) ---------------------
# Minutes before an event's START TIME that its Room ID and password unlock for the
# players holding a confirmed seat. Free Fire's own custom-room lock window is short,
# so a large lead hands players a room that has already closed. The lead is measured
# BACK from the start instant, so a longer number unlocks EARLIER; 0 means "no lead" and
# opens the room at the start itself (pin an exact release time in the admin room panel if
# you need a room out before then). An event can override this in that panel (its own lead,
# or a pinned instant), and so can the `tournament.roomReleaseMinutes` platform setting —
# which is what the admin Settings page edits, so the deployment default below is used
# until someone changes it at runtime.
# Precedence: event's pinned instant > event's lead > this setting > ROOM_RELEASE_MINUTES.
ROOM_RELEASE_MINUTES="5"

# Uploads (Railway: attach a Volume and set UPLOAD_DIR=/data/uploads)
MAX_UPLOAD_MB="5"
UPLOAD_DIR="uploads"

# === Email (verification + password reset) ===
# log | smtp | resend | postmark
# "log" only prints to stdout and is REFUSED when NODE_ENV=production —
# a live site whose reset emails go nowhere is broken in a way nobody notices.
EMAIL_PROVIDER="log"

# Local testing ONLY. When true (and NODE_ENV is not production and
# EMAIL_PROVIDER is "log"), the API echoes email-verification and password-reset
# tokens in its JSON responses so the flows are testable without a mail
# provider. NEVER enable this on a deployed environment: it hands a valid
# password-reset token to anyone who submits a victim's email address.
AUTH_ECHO_TOKENS="false"
EMAIL_FROM="CLUTCHNEX <no-reply@localhost>"
# EMAIL_REPLY_TO="support@clutchnex.gg"
EMAIL_TIMEOUT_MS="10000"
EMAIL_ATTEMPTS="3"

# --- provider: smtp (any relay: SES SMTP, Postfix, Google Workspace, cPanel) ---
# SMTP_HOST="email-smtp.eu-west-1.amazonaws.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"        # true = implicit TLS on 465; false = STARTTLS on 587
# SMTP_USER="AKIA..."
# SMTP_PASS="..."

# --- provider: resend (https://resend.com) ---
# RESEND_API_KEY="re_..."

# --- provider: postmark (https://postmarkapp.com) ---
# POSTMARK_SERVER_TOKEN="..."

# Global per-IP request ceiling per 15 minutes (anti-scrape). Sensitive routes
# (auth, deposits, withdrawals, joins, coupons) have their own tighter budgets
# in code — lower this only if you sit behind aggressive caching.
RATE_LIMIT_PER_WINDOW="600"

# NOTE (Prisma 7): the CLI reads DATABASE_URL/DIRECT_URL via prisma.config.ts.
# Runtime code uses DATABASE_URL through the @prisma/adapter-pg driver adapter.
# If `binaries.prisma.sh` is unreachable in your network, Prisma's WASM-based
# validate/format/generate paths still work; see backend/README.md.
