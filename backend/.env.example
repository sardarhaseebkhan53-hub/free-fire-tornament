# === CLUTCHNEX backend environment (example — copy to .env and fill) ===

# PostgreSQL connection string (managed Postgres in production)
# For local dev without a Postgres install, run `npm run db:dev` (embedded PGlite Postgres on :5432)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?connection_limit=5"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:3000"

# Auth — use long random secrets in production (openssl rand -hex 64)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"

# Seed super admin (DEV ONLY — never use these values in production)
SEED_ADMIN_EMAIL="admin@clutchnex.gg"
SEED_ADMIN_PASSWORD="ChangeMe-Admin123"
SEED_ADMIN_USERNAME="clutchadmin"

# Public URL (SEO, shares)
PUBLIC_URL="http://localhost:3000"

# Uploads
MAX_UPLOAD_MB="5"
UPLOAD_DIR="uploads"

# === Email (verification + password reset) ===
# log | smtp | resend | postmark
# "log" only prints to stdout and is REFUSED when NODE_ENV=production —
# a live site whose reset emails go nowhere is broken in a way nobody notices.
EMAIL_PROVIDER="log"
EMAIL_FROM="CLUTCHNEX <no-reply@localhost>"
# EMAIL_REPLY_TO="support@clutchnex.gg"
EMAIL_TIMEOUT_MS="10000"
EMAIL_ATTEMPTS="3"

# --- provider: smtp (any relay: SES SMTP, Postfix, Google Workspace, cPanel) ---
# SMTP_HOST="email-smtp.eu-west-1.amazonaws.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"        # true = implicit TLS on 465; false = STARTTLS on 587
# SMTP_USER="AKIA..."
# SMTP_PASS="..."

# --- provider: resend (https://resend.com) ---
# RESEND_API_KEY="re_..."

# --- provider: postmark (https://postmarkapp.com) ---
# POSTMARK_SERVER_TOKEN="..."

# Global per-IP request ceiling per 15 minutes (anti-scrape). Sensitive routes
# (auth, deposits, withdrawals, joins, coupons) have their own tighter budgets
# in code — lower this only if you sit behind aggressive caching.
RATE_LIMIT_PER_WINDOW="600"

# NOTE (Prisma 7): the CLI reads DATABASE_URL via prisma.config.ts.
# Runtime code uses it through the @prisma/adapter-pg driver adapter.
# If `binaries.prisma.sh` is unreachable in your network, Prisma's WASM-based
# validate/format/generate paths still work; see backend/README.md.
