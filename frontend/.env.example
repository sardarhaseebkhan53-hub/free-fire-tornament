# CLUTCHNEX web app (Next.js) — environment template
# Copy to .env.local for development, or set these in your host's env for production.
# See DEPLOYMENT.md §5.

# Where the Next.js server (and its /api/backend/* proxy) reaches the API.
# SERVER-SIDE ONLY — never exposed to the browser, which always calls the
# relative /api/backend/... proxy instead.
BACKEND_URL=http://127.0.0.1:4000

# The public origin this site is served from. Used for metadataBase, canonical
# URLs, Open Graph tags, the sitemap and JSON-LD. Must match the deployed
# origin exactly, or every canonical URL will point somewhere else.
PUBLIC_URL=http://localhost:3000

# The service worker only registers when NODE_ENV=production.
# NODE_ENV=production
