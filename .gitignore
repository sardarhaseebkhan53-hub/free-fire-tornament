# Dependencies
node_modules/

# Build output
dist/
.next/
out/
build/

# Environment — never commit secrets
.env
.env.local
.env.*.local
backend/.env

# Dev database (embedded PGlite) & API upload storage (runtime files only —
# scoped to backend/ so frontend/src/app/uploads/ (the proxy route) is NOT ignored)
pgdata/
backend/uploads/

# Test database + test upload scratch (Vitest boots its own PGlite on :55432)
.test-pgdata/
.test-uploads/

# Prisma generated client (regenerated via `npm run db:generate`)
backend/generated/

# Logs & OS
*.log
.DS_Store
npm-debug.log*

# Tooling caches
.turbo/
coverage/
